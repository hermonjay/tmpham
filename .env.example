# Copy to .env and tweak. Values shown are defaults used by docker-compose.yml.

# ---- shared ----
TZ=UTC

# ---- analytics-app ----
# Path inside the container where DuckDB file is written.
# Matches the volume mount in docker-compose.yml (duckdb-data:/app/duckdb).
DUCKDB_PATH=/app/duckdb/analytics.duckdb

# Where the app scans for *.csv snapshots (read-only bind mount of ./data).
SNAPSHOT_DIR=/app/data/snapshots

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- metabase ----
# Host port published for the Metabase UI.
MB_PORT=3000

# Metabase + DuckDB driver versions. Bump them together; the driver is
# published against a specific Metabase minor line (1.5.3.0 -> 0.59.x).
METABASE_VERSION=v0.59.x
DUCKDB_DRIVER_VERSION=1.5.3.0
